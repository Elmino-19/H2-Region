		"editor.tokenColorCustomizations": {
			"[*]": {
				"textMateRules": [
					{
						"scope": [
							"string.quoted.single",
							"string.quoted.double",
							"string.quoted.other",
							"string.template",
							"string.interpolated",
							"string.regexp"
						],
						"settings": {
							"foreground": "#1eff1e"
						}
					},
					{
						"scope": [
							"string.quoted.triple",
							"comment.block.documentation",
							"comment.block.documentation.python"
						],
						"settings": {
							"foreground": "#707070",
							"fontStyle": "italic"
						}
					},
					{
						"scope": [
							"variable",
							"variable.parameter",
							"variable.other",
							"variable.language"
						],
						"settings": {
							"foreground": "#ff006a"
						}
					},
					{
						"scope": [
							"variable.other.constant"
						],
						"settings": {
